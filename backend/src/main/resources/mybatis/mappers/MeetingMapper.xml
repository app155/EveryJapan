<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.Globalin.dao.MeetingDao">

    <resultMap id="MeetingResultMap" type="com.example.Globalin.model.Meeting">
        <id property="meetingId" column="meeting_id" />
        <result property="userId" column="user_id" />
        <result property="title" column="title" />
        <result property="content" column="content" />
        <result property="location" column="location" />
        <result property="meetingDate" column="meeting_date" />
        <result property="maxMembers" column="max_members" />
        <result property="currentMembers" column="current_members" />
        <result property="createdAt" column="created_at" />
        <result property="authorNickname" column="nickname" /> </resultMap>

    <insert id="insertMeeting" parameterType="com.example.Globalin.model.Meeting" 
            useGeneratedKeys="true" keyProperty="meetingId">
        INSERT INTO meetings (
            user_id, title, content, location, meeting_date, max_members
        ) VALUES (
            #{userId}, #{title}, #{content}, #{location}, #{meetingDate}, #{maxMembers}
        )
    </insert>

    <select id="selectAllMeetings" resultMap="MeetingResultMap">
        SELECT m.*, u.nickname 
        FROM meetings m
        JOIN users u ON m.user_id = u.id
        ORDER BY m.meeting_date ASC
    </select>

    <select id="selectMeetingById" resultMap="MeetingResultMap">
        SELECT m.*, u.nickname 
        FROM meetings m
        JOIN users u ON m.user_id = u.id
        WHERE m.meeting_id = #{meetingId}
    </select>

    <update id="updateMemberCount">
        UPDATE meetings 
        SET current_members = current_members + 1 
        WHERE meeting_id = #{meetingId}
    </update>

</mapper>